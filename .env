# Integração com o backend (npm run dev no `web` + API em localhost:5001)
# Use `/api` para o proxy do Next.js repassar ao backend — mesma origem = cookie HttpOnly do JWT funciona.
BACKEND_URL=http://localhost:5001
NEXT_PUBLIC_USE_MOCK=false
# true = envia header x-use-test-db (bootstrap de admin em ambiente de teste). false = integração "normal".
NEXT_PUBLIC_USE_TEST_DB=false

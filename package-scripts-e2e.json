{
  "scripts": {
    "e2e:open": "cypress open",
    "e2e:run": "cypress run",
    "e2e:run:parallel": "cypress run --parallel",
    "e2e:run:ci": "cypress run --record --key $CYPRESS_RECORD_KEY --parallel",
    "e2e:run:headless": "cypress run --headless",
    "e2e:run:chrome": "cypress run --browser chrome",
    "e2e:run:firefox": "cypress run --browser firefox",
    "e2e:run:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
    "e2e:run:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024",
    "e2e:run:desktop": "cypress run --config viewportWidth=1920,viewportHeight=1080",
    "e2e:run:smoke": "cypress run --spec 'cypress/e2e/**/*smoke*.cy.ts'",
    "e2e:run:critical": "cypress run --spec 'cypress/e2e/**/*critical*.cy.ts'",
    "e2e:run:regression": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "e2e:run:vendas": "cypress run --spec 'cypress/e2e/vendas/**/*.cy.ts'",
    "e2e:run:admin": "cypress run --spec 'cypress/e2e/admin/**/*.cy.ts'",
    "e2e:run:clientes": "cypress run --spec 'cypress/e2e/clientes/**/*.cy.ts'",
    "e2e:run:pagamentos": "cypress run --spec 'cypress/e2e/pagamentos/**/*.cy.ts'",
    "e2e:run:entregas": "cypress run --spec 'cypress/e2e/entregas/**/*.cy.ts'",
    "e2e:run:trocas": "cypress run --spec 'cypress/e2e/trocas/**/*.cy.ts'",
    "e2e:run:catalogo": "cypress run --spec 'cypress/e2e/catalogo/**/*.cy.ts'",
    "e2e:run:autenticacao": "cypress run --spec 'cypress/e2e/autenticacao/**/*.cy.ts'",
    "e2e:run:ia": "cypress run --spec 'cypress/e2e/ia/**/*.cy.ts'",
    "e2e:run:notificacoes": "cypress run --spec 'cypress/e2e/notificacoes/**/*.cy.ts'",
    "e2e:run:responsividade": "cypress run --spec 'cypress/e2e/responsividade/**/*.cy.ts'",
    "e2e:run:split": "cypress run --split --split-filepattern=cypress/e2e/**/*.cy.ts",
    "e2e:run:split:ci": "cypress run --split --split-filepattern=cypress/e2e/**/*.cy.ts --record --key $CYPRESS_RECORD_KEY",
    "e2e:run:performance": "cypress run --config video=false,screenshotOnRunFailure=false --spec 'cypress/e2e/**/*performance*.cy.ts'",
    "e2e:run:debug": "cypress run --debug --spec",
    "e2e:run:verbose": "CYPRESS_VERBOSE=true cypress run",
    "e2e:clean": "rm -rf cypress/screenshots cypress/videos cypress/results",
    "e2e:report": "cypress run --reporter cypress-multi-reporters",
    "e2e:coverage": "cypress run --env coverage=true",
    "e2e:lint": "eslint cypress/**/*.ts",
    "e2e:lint:fix": "eslint cypress/**/*.ts --fix",
    "e2e:typecheck": "tsc --noEmit cypress/**/*.ts",
    "e2e:validate": "npm run e2e:lint && npm run e2e:typecheck",
    "e2e:setup": "npm run e2e:clean && npm run e2e:validate",
    "e2e:all": "npm run e2e:setup && npm run e2e:run:parallel",
    "e2e:ci": "npm run e2e:setup && npm run e2e:run:ci"
  }
}
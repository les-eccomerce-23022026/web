    "test:e2e:clientes:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/clientes/**/*.cy.ts'\"",
    "test:e2e:vendas": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/vendas/**/*.cy.ts'\"",

{
  "name": "prototipo-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "dev:e2e": "next dev -H 0.0.0.0 -p 3001",
    "dev:e2e:3002": "next dev -H 0.0.0.0 -p 3002",
    "dev:vite": "vite",
    "build": "next build",
    "build:vite": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "next start",
    "preview:vite": "vite preview",
    "db:reset:all": "npm --prefix .. run db:reset:all",
    "test:e2e": "start-server-and-test dev:e2e 3001 \"cypress run\"",
    "test:e2e:open": "cypress open --browser chrome --e2e",
    "test:e2e:autenticacao": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/autenticacao/**/*.cy.ts'\"",
    "test:e2e:autenticacao:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/autenticacao/**/*.cy.ts'\"",
    "test:e2e:catalogo": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/catalogo/**/*.cy.ts'\"",
    "test:e2e:catalogo:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/catalogo/**/*.cy.ts'\"",
    "test:e2e:carrinho": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/carrinho/**/*.cy.ts'\"",

{
  "name": "prototipo-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "dev:e2e": "next dev -H 0.0.0.0 -p 3001",
    "dev:vite": "vite",
    "build": "next build",
    "build:vite": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "next start",
    "preview:vite": "vite preview",
    "db:reset:all": "npm --prefix .. run db:reset:all",
   
    "test:e2e:compras": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headless --spec 'cypress/e2e/entrega7/multi-tenancy-loja.cy.ts'\"",
    "test:e2e:compras:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/entrega7/multi-tenancy-loja.cy.ts'\"",
    "test:e2e:troca-devolucao": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headless --spec 'cypress/e2e/entrega7/troca-devolucao.cy.ts'\"",
    "test:e2e:troca-devolucao:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/entrega7/troca-devolucao.cy.ts'\"",
    "dev:backend": "cd ../backend && npm run dev",
    "test:e2e:full": "start-server-and-test 'npm run dev:backend' 5001 'npm run dev:e2e' 3001 \"cypress run\"",
    "cypress:install": "cypress install",
    "cypress:verify": "cypress verify",
    "cypress:reset": "bash scripts/ensure-cypress.sh",
    "test:e2e:ci": "cypress run --browser electron",
    "test:e2e:ci:spec": "cypress run --browser electron --spec",
    "test:e2e:headed:electron": "cypress run --browser electron --headed"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cypress": "^13.17.0",
    "cypress-terminal-report": "^7.3.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "msw": "^2.13.6",
    "playwright": "^1.60.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "allowScripts": {
    "cypress@13.17.0": true
  }
}

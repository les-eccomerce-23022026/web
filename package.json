    "test:e2e:entregas:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/entregas/**/*.cy.ts'\"",
    "test:e2e:trocas": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/trocas/**/*.cy.ts'\"",
    "test:e2e:trocas:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/trocas/**/*.cy.ts'\"",
    "test:e2e:admin": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/admin/**/*.cy.ts'\"",
    "test:e2e:admin:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/admin/**/*.cy.ts'\"",
    "test:e2e:responsividade": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/responsividade/**/*.cy.ts'\"",
    "test:e2e:responsividade:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/responsividade/**/*.cy.ts'\"",
    "test:e2e:fluxo-compra": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/realizar-compra-completa.cy.ts'\"",
    "test:e2e:fluxo-compra:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/realizar-compra-completa.cy.ts'\"",
    "test:e2e:fluxo-checkout": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/pagamentos/*.cy.ts,cypress/e2e/entregas/cotacao-de-frete-no-checkout.cy.ts'\"",
    "test:e2e:fluxo-checkout:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/pagamentos/*.cy.ts,cypress/e2e/entregas/cotacao-de-frete-no-checkout.cy.ts'\"",
    "test:e2e:vendas:failed": "start-server-and-test dev:e2e 3001 \"cypress run --spec 'cypress/e2e/vendas/etapas-do-checkout.cy.ts,cypress/e2e/vendas/evidencias-visuais-compra.cy.ts,cypress/e2e/vendas/falhas-na-compra.cy.ts,cypress/e2e/vendas/fluxo-multi-loja.cy.ts,cypress/e2e/vendas/fluxo-ponta-a-ponta.cy.ts,cypress/e2e/vendas/multiplas-falhas-consecutivas.cy.ts,cypress/e2e/vendas/pedido-confirmado.cy.ts,cypress/e2e/vendas/realizar-compra-completa.cy.ts,cypress/e2e/vendas/validacoes-de-formularios.cy.ts,cypress/e2e/vendas/caminho-feliz/02-checkout-preparacao.cy.ts'\"",
    "test:e2e:entrega7-venda-completa": "CYPRESS_SKIP_VERIFY=true start-server-and-test dev:e2e 3001 \"cypress run --browser chromium --spec 'cypress/e2e/vendas/realizar-compra-completa.cy.ts,cypress/e2e/pagamentos/combinacoes-de-pagamento.cy.ts,cypress/e2e/pagamentos/pagamento-aprovado.cy.ts,cypress/e2e/clientes/registrar-cartao-e-endereco-checkout.cy.ts,cypress/e2e/trocas/solicitar-troca-cliente.cy.ts,cypress/e2e/trocas/solicitar-troca-validacoes.cy.ts,cypress/e2e/trocas/autorizar-ou-rejeitar-troca.cy.ts,cypress/e2e/trocas/confirmar-recebimento.cy.ts,cypress/e2e/trocas/cupom-gerado-pela-troca.cy.ts,cypress/e2e/entregas/despachar-pedido.cy.ts,cypress/e2e/entregas/confirmar-entregue.cy.ts'\"",
    "test:e2e:entrega7-venda-completa:headed": "start-server-and-test dev:e2e 3001 \"cypress run --browser chrome --headed --spec 'cypress/e2e/vendas/realizar-compra-completa.cy.ts,cypress/e2e/pagamentos/combinacoes-de-pagamento.cy.ts,cypress/e2e/pagamentos/pagamento-aprovado.cy.ts,cypress/e2e/clientes/registrar-cartao-e-endereco-checkout.cy.ts,cypress/e2e/trocas/solicitar-troca-cliente.cy.ts,cypress/e2e/trocas/solicitar-troca-validacoes.cy.ts,cypress/e2e/trocas/autorizar-ou-rejeitar-troca.cy.ts,cypress/e2e/trocas/confirmar-recebimento.cy.ts,cypress/e2e/trocas/cupom-gerado-pela-troca.cy.ts,cypress/e2e/entregas/despachar-pedido.cy.ts,cypress/e2e/entregas/confirmar-entregue.cy.ts'\"",
    "cypress:install": "cypress install",
    "cypress:verify": "cypress verify",
    "cypress:reset": "bash scripts/ensure-cypress.sh",
    "test:e2e:ci": "cypress run --browser electron",
    "test:e2e:ci:spec": "cypress run --browser electron --spec",
    "test:e2e:headed:electron": "cypress run --browser electron --headed"

{
  "name": "prototipo-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:e2e": "next dev -H 0.0.0.0 -p 3001",
    "dev:e2e:3002": "next dev -H 0.0.0.0 -p 3002",
    "dev:vite": "vite",
    "build": "next build",
    "build:vite": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "next start",
    "preview:vite": "vite preview",
    "test:e2e:seo": "echo 'SEO tests removidos - use test:e2e:run'",
    "db:reset:all": "npm --prefix .. run db:reset:all",
    "test:e2e": "npm run test:e2e:compra:run",
    "test:e2e:run": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:integration:run": "echo 'Integration tests removidos - use test:e2e:run'",
    "test:e2e:entrega-7:run": "cypress run --config video=false --env injectTestDbHeader=true,apiUrl=http://localhost:3000/api --spec \"cypress/e2e/**/*.cy.ts\"",
    "test:e2e:entrega-7:open": "cypress open --e2e --config video=false,specPattern=cypress/e2e/**/*.cy.ts --env injectTestDbHeader=true,apiUrl=http://localhost:3000/api",
    "test:e2e:entrega-7:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true,apiUrl=http://localhost:3000/api --spec \"cypress/e2e/**/*.cy.ts\"",
    "test:e2e:entrega-7-ui:run": "cypress run --config video=false,baseUrl=http://localhost:3001 --env injectTestDbHeader=true,apiUrl=http://localhost:3001/api --spec \"cypress/e2e/**/*.cy.ts\"",
    "test:e2e:entrega-7-ui:open": "cypress run --config video=false,baseUrl=http://localhost:3001 --headed --browser chrome --env injectTestDbHeader=true,apiUrl=http://localhost:3001/api --spec \"cypress/e2e/**/*.cy.ts\"",
    "test:e2e:entrega-7-ui:headed": "npm run test:e2e:entrega-7-ui:open",
    "test:e2e:entrega-7-ui:gui": "cypress open --e2e --config video=false,baseUrl=http://localhost:3001,specPattern=cypress/e2e/**/*.cy.ts --env injectTestDbHeader=true,apiUrl=http://localhost:3001/api",
    "cypress:run:e2e:testdb": "npm run test:e2e:compra:run",
    "cypress:run:e2e-compra-devdb": "cypress run --config video=false --env injectTestDbHeader=false --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/falhas-na-compra.cy.ts,cypress/e2e/carrinho/gerenciar-carrinho-e-cotar-frete.cy.ts\"",
    "cypress:run:e2e-compra-testdb": "npm run test:e2e:compra:run",
    "cypress:run:e2e-checkout-pagamento": "npm run test:e2e:checkout-large:run",
    "test:e2e:compra:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/falhas-na-compra.cy.ts,cypress/e2e/carrinho/gerenciar-carrinho-e-cotar-frete.cy.ts\"",
    "test:e2e:compra:chrome": "cypress run --config video=false --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/falhas-na-compra.cy.ts,cypress/e2e/carrinho/gerenciar-carrinho-e-cotar-frete.cy.ts\"",
    "test:e2e:compra:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/falhas-na-compra.cy.ts,cypress/e2e/carrinho/gerenciar-carrinho-e-cotar-frete.cy.ts\"",
    "test:e2e:compra-feliz:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts\"",
    "test:e2e:compra-feliz:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts\"",
    "test:e2e:compra-falhas:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/falhas-na-compra.cy.ts\"",
    "test:e2e:compra-falhas:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/falhas-na-compra.cy.ts\"",
    "test:e2e:carrinho:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/carrinho/gerenciar-carrinho-e-cotar-frete.cy.ts\"",
    "test:e2e:carrinho:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/carrinho/gerenciar-carrinho-e-cotar-frete.cy.ts\"",
    "test:e2e:checkout-large:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/pagamentos/pagamento-no-checkout.cy.ts,cypress/e2e/entregas/cotacao-de-frete-no-checkout.cy.ts\"",
    "test:e2e:checkout-large:chrome": "cypress run --config video=false --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/pagamentos/pagamento-no-checkout.cy.ts,cypress/e2e/entregas/cotacao-de-frete-no-checkout.cy.ts\"",
    "test:e2e:pagamento:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/pagamentos/pagamento-no-checkout.cy.ts\"",
    "test:e2e:pagamento:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/pagamentos/pagamento-no-checkout.cy.ts\"",
    "test:e2e:entrega-frete:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/entregas/cotacao-de-frete-no-checkout.cy.ts\"",
    "test:e2e:entrega-frete:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/entregas/cotacao-de-frete-no-checkout.cy.ts\"",
    "padroes:check": "node ./scripts/validarPadroesFrontend.mjs",
    "padroes:check:strict": "node ./scripts/validarPadroesFrontend.mjs --strict",
    "test:e2e:fluxo-compra:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/fluxo-ponta-a-ponta.cy.ts,cypress/e2e/vendas/evidencias-visuais-compra.cy.ts\"",
    "test:e2e:fluxo-compra:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts,cypress/e2e/vendas/fluxo-ponta-a-ponta.cy.ts,cypress/e2e/vendas/evidencias-visuais-compra.cy.ts\"",
    "test:e2e:fluxo-compra:gui": "cypress open --e2e --config video=false,specPattern=cypress/e2e/vendas/caminho-feliz-compra.cy.ts --env injectTestDbHeader=true",
    "test:e2e:happy-path:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts\"",
    "test:e2e:happy-path:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/caminho-feliz-compra.cy.ts\"",
    "test:e2e:cross-domain:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/fluxo-ponta-a-ponta.cy.ts\"",
    "test:e2e:cross-domain:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/fluxo-ponta-a-ponta.cy.ts\"",
    "test:e2e:screenshots:run": "cypress run --config video=false --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/evidencias-visuais-compra.cy.ts\"",
    "test:e2e:screenshots:headed": "cypress run --config video=false --headed --browser chrome --env injectTestDbHeader=true --spec \"cypress/e2e/vendas/evidencias-visuais-compra.cy.ts\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cypress": "^15.10.0",
    "cypress-terminal-report": "^7.3.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "msw": "^2.13.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
